---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
const posts = (await getCollection('blog', ({data}) => !data.draft))
  .sort((a,b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---
<PageLayout title="Blog | Jiwoong Choi" description="인프라, 보안 연구와 실험에서 배운 내용을 기록합니다.">
  <main>
    <header class="page-header">
      <span class="eyebrow">Technical writing</span><h1>Blog</h1>
      <p class="page-lead">문제 정의 → 가설 → 실험 → 결과 → 한계. 단순한 방법 소개보다 판단이 어떻게 바뀌었는지를 기록합니다.</p>
    </header>
    <div class="post-list">
      {posts.map((post) => (
        <a class="post-item" href={'/blog/' + post.id + '/'}>
          <div><strong>{post.data.title}</strong><p>{post.data.description}</p></div>
          <small>{post.data.pubDate.toLocaleDateString('ko-KR')}</small>
        </a>
      ))}
    </div>
    {posts.length === 0 && <div class="empty-state">현재 공개된 글이 없습니다. 새로운 기술 글을 발행하면 이곳에 자동으로 나타납니다.</div>}
  </main>
</PageLayout>
